# Onewill Academy | Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real API keys/credentials to Git.

# Application Base Config
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"
APP_URL="http://localhost:3000"

# Firebase Client Web SDK Configuration (Exposed to browser via NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_CLIENT_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="onewill-academy-weekly-report.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="onewill-academy-weekly-report"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="onewill-academy-weekly-report.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Firebase Admin SDK Configuration (Server-only credentials, NEVER expose to client)
FIREBASE_PROJECT_ID="onewill-academy-weekly-report"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@onewill-academy-weekly-report.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
